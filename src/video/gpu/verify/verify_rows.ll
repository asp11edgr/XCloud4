; SPDX-License-Identifier: GPL-3.0-only
; Original XCloud4 sparse verification copy. No conversion or filtering.
; Four raw SRDs: native NV12, converted RGBA, private WB snapshot, parameters.
; Old shaders and their machine arrays are not regenerated by this source.
; user_sgprs=16
; tgid_y=1
; local_y=1
; threads_x=8
; threads_y=8
target triple = "amdgcn--"
declare i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32>, i32, i32, i32 immarg)
declare void @llvm.amdgcn.raw.buffer.store.i32(i32, <4 x i32>, i32, i32, i32 immarg)
define amdgpu_cs void @main(<4 x i32> inreg %yb, <4 x i32> inreg %uvb, <4 x i32> inreg %out, <4 x i32> inreg %params, i32 inreg %gx, i32 inreg %gy, i32 %tx, i32 %ty) #0 {
entry:
  %bx = shl i32 %gx, 3
  %by = shl i32 %gy, 3
  %x = add i32 %bx, %tx
  %y = add i32 %by, %ty
  %sp = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 0, i32 0, i32 0)
  %cp = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 4, i32 0, i32 0)
  %suv = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 8, i32 0, i32 0)
  %duv = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 12, i32 0, i32 0)
  %rgbaoffset = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 16, i32 0, i32 0)
  %dp = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 20, i32 0, i32 0)
  %yf = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 24, i32 0, i32 0)
  %yn = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 28, i32 0, i32 0)
  %uvf = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 32, i32 0, i32 0)
  %uvn = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 36, i32 0, i32 0)
  %first = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 40, i32 0, i32 0)
  %rows = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %params, i32 44, i32 0, i32 0)
  %words = lshr i32 %cp, 2
  %wordok = icmp ult i32 %x, %words
  %yok = icmp ult i32 %y, %yn
  %copyy = and i1 %wordok, %yok
  %wordbyte = shl i32 %x, 2
  br i1 %copyy, label %luma, label %luma_done
luma:
  %sy = add i32 %yf, %y
  %yrow = mul i32 %sy, %sp
  %ysrc = add i32 %yrow, %wordbyte
  %yval = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %yb, i32 %ysrc, i32 0, i32 0)
  %ycrow = mul i32 %sy, %cp
  %ydst = add i32 %ycrow, %wordbyte
  call void @llvm.amdgcn.raw.buffer.store.i32(i32 %yval, <4 x i32> %out, i32 %ydst, i32 0, i32 0)
  br label %luma_done
luma_done:
  %uvok = icmp ult i32 %y, %uvn
  %copyuv = and i1 %wordok, %uvok
  br i1 %copyuv, label %chroma, label %chroma_done
chroma:
  %uvy = add i32 %uvf, %y
  %uvrow = mul i32 %uvy, %sp
  %uvsrc0 = add i32 %suv, %uvrow
  %uvsrc = add i32 %uvsrc0, %wordbyte
  %uvval = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %yb, i32 %uvsrc, i32 0, i32 0)
  %uvcrow = mul i32 %uvy, %cp
  %uvdst0 = add i32 %duv, %uvcrow
  %uvdst = add i32 %uvdst0, %wordbyte
  call void @llvm.amdgcn.raw.buffer.store.i32(i32 %uvval, <4 x i32> %out, i32 %uvdst, i32 0, i32 0)
  br label %chroma_done
chroma_done:
  %xok = icmp ult i32 %x, 1920
  %rgbaok = icmp ult i32 %y, %rows
  %copyrgba = and i1 %xok, %rgbaok
  br i1 %copyrgba, label %rgba, label %exit
rgba:
  %ry = add i32 %first, %y
  %rrow = mul i32 %ry, %dp
  %rpixel = add i32 %rrow, %x
  %rsrc = shl i32 %rpixel, 2
  %rval = call i32 @llvm.amdgcn.raw.buffer.load.i32(<4 x i32> %uvb, i32 %rsrc, i32 0, i32 0)
  %rcrow = mul i32 %y, 1920
  %rcpixel = add i32 %rcrow, %x
  %rcbyte = shl i32 %rcpixel, 2
  %rdst = add i32 %rgbaoffset, %rcbyte
  call void @llvm.amdgcn.raw.buffer.store.i32(i32 %rval, <4 x i32> %out, i32 %rdst, i32 0, i32 0)
  br label %exit
exit:
  ret void
}
attributes #0 = { "amdgpu-flat-work-group-size"="64,64" }
